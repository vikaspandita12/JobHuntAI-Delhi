# Anthropic API — for cover letter generation
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Gmail SMTP — for daily job digest emails
# Use Gmail App Password: myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASS=your_gmail_app_password

# Optional: override default email recipients
VIKAS_EMAIL=vikaspandita1@gmail.com
DIKSHA_EMAIL=dikshakoul88@gmail.com

# Scan schedule — cron format (default: 8 AM IST daily)
SCAN_CRON_HOUR=8
SCAN_CRON_MINUTE=0

# Minimum match score to include in email (0-100)
VIKAS_MIN_SCORE=60
DIKSHA_MIN_SCORE=50
